# Copy this file to ".env" and fill in YOUR keys. Never share or commit ".env".

# --- Google Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model name. Run `python check_setup.py` to list the models your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Gnani speech (key from https://app.gnani.ai/voice) ---
GNANI_API_KEY=

# --- Where you extracted Capstone_Project_Dataset_FTTT_2026.zip ---
# Leave empty if the dataset folder sits next to this project folder.
DATASET_DIR=

# --- Optional tuning ---
# auto = try Gemini embeddings, fall back to keyword search; bm25 = keyword search only
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=gemini-embedding-001
TOP_K=5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_STT_LANGUAGE=en-IN,hi-IN
# Voice for Hindi/Hinglish replies (leave empty to use GNANI_TTS_VOICE). `python check_setup.py` lists voices.
GNANI_TTS_VOICE_HINDI=
